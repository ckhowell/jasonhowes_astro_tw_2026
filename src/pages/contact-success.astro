        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
          <a href="/" class="btn btn-primary">
            Back to Home
          </a>
          <a href="/courses" class="btn btn-secondary">
            Explore Courses
          </a>
        </div>

        <!-- Contact Info -->
        <div class="text-center border-t border-brand-200 dark:border-brand-700 pt-8 mt-8">
          <p class="text-sm text-brand-500 dark:text-brand-500 mb-4">

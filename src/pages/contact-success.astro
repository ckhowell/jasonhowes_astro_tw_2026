---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Message Sent | Jason Howes";
const pageDescription = "Your message has been received. We'll be in touch within 24-48 business hours.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Nav variant="light" />

  <!-- Success Section -->
  <section class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="max-w-2xl w-full">
      <!-- Success Card -->
      <div class="text-center card-glass-strong p-12">
        <!-- Success Icon -->
        <div class="w-20 h-20 bg-brand-100 dark:bg-brand-800 rounded-full flex items-center justify-center mx-auto mb-8 animate-pulse">
          <i class="bx bx-check text-5xl text-brand-600 dark:text-brand-400"></i>
        </div>

        <!-- Heading -->
        <h1 class="text-4xl md:text-5xl font-bold text-brand-700 dark:text-brand-100 mb-4">
          Message sent!
        </h1>

        <!-- Subheading -->
        <p class="text-xl text-brand-600 dark:text-brand-400 mb-2">
          Thank you for reaching out.
        </p>
        <p class="text-lg text-brand-500 dark:text-brand-500 mb-8">
          We'll get back to you within 24–48 business hours.
        </p>


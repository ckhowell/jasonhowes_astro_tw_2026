---
// Podcast page
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Sales Leadership Podcast | Jason Howes";
const pageDescription = "The Art & Science of Complex Sales podcast with Jason Howes. Weekly insights on sales management, hiring, and building high-performance teams.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Nav variant="light" />

  <!-- Hero -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm uppercase tracking-[0.15em] text-brand-500 dark:text-brand-400 mb-4">
            Art & Science of Complex Sales
          </p>
          <h1 class="text-brand-700 dark:text-brand-100 mb-6">
            Candid conversations with top performers
          </h1>
          <p class="text-lg text-brand-600 dark:text-brand-400">
            Weekly insights on sales management, leadership, and building high-performance teams. No fluff, just actionable wisdom.
          </p>
        </div>
        <div class="flex justify-center">
          <img
            src="/jason-howes-podcast-5.webp"
            alt="Jason Howes Podcast"
            class="w-full h-96 md:h-[500px] rounded-2xl shadow-xl object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Episodes - Buzzsprout Player -->
  <section class="py-16 md:py-24 px-4 bg-brand-50 dark:bg-brand-950">
    <div class="max-w-7xl mx-auto">
      <h2 class="mb-12 text-brand-700 dark:text-brand-100">
        Latest Episodes
      </h2>

      <!-- Buzzsprout Embedded Player -->
      <div class="buzzsprout-player-container">
        <div id="buzzsprout-small-player-limit-20"></div>
        <script
          type="text/javascript"
          charset="utf-8"
          src="https://www.buzzsprout.com/2552890.js?artist=&container_id=buzzsprout-small-player-limit-20&limit=20&player=small"
          is:inline
        ></script>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Container styling for Buzzsprout player */
  .buzzsprout-player-container {
    background: rgba(255, 255, 255, 0.4);
    border-radius: 1rem;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  }

  :global(.dark) .buzzsprout-player-container {
    background: rgba(30, 58, 138, 0.4);
    border-color: rgba(59, 130, 246, 0.3);
  }
</style>

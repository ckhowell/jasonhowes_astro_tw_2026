---
// Courses page
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const courses = [
  {
    title: 'Consultative Selling: Land a $10m Contract',
    subtitle: 'Uncover buying motives through strategic questioning',
    description: 'Teaches uncovering buying motives through strategic questioning. Techniques used in securing 8-figure deals. Combinable with the Closing course.',
    duration: 'Full-day',
    format: 'Workshop',
    link: '#',
    featured: true
  },
  {
    title: 'Prospecting: Become a Confident Hunter',
    subtitle: 'Build a steady pipeline of qualified opportunities',
    description: 'Build a steady pipeline of qualified opportunities. Includes 5x 60-minute sessions (fortnightly), microlearning, and coaching review.',
    duration: 'Full-day',
    format: 'Workshop',
    link: '#'
  },
  {
    title: 'Closing: Win More, Win Smarter',
    subtitle: 'Identify decision points and remove roadblocks',
    description: 'Uses milestone-driven approach to identify decision points and remove roadblocks. Works alongside Consultative Selling with applied coaching.',
    duration: 'Full-day',
    format: 'Workshop',
    link: '#'
  },
  {
    title: 'Sales Mindset: Uncover Hidden Barriers',
    subtitle: 'Identify mindset blocks limiting performance',
    description: 'Identifies mindset blocks limiting performance. Includes 3x 60-minute virtual sessions (weekly), 1x 30-minute coaching, microlearning videos, and weekly tasks.',
    duration: 'Half-day',
    format: 'Virtual',
    link: '#'
  },
  {
    title: 'Relationship Building: Accelerate Trust',
    subtitle: 'Develop trusted advisor positioning',
    description: 'Develops trusted advisor positioning to shorten sales cycles. Virtual program format with practical exercises and microlearning.',
    duration: 'Half-day',
    format: 'Virtual',
    link: '#'
  },
  {
    title: 'Selling Value: Protect Your Margin',
    subtitle: 'Position as strategic choice not price-focused',
    description: 'Teaches positioning as a strategic choice rather than a price-focused competitor. Half-day format with tailored pricing exercises and role-plays.',
    duration: 'Half-day',
    format: 'Workshop',
    link: '#'
  }
];
const pageTitle = "Sales Training Courses | Jason Howes Online Programs";
const pageDescription = "Self-paced online sales courses covering prospecting, sales management, storytelling, and recruiting. Learn from Jason Howes with 35+ years of sales leadership experience.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Nav variant="light" />

  <!-- Hero -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm uppercase tracking-[0.15em] text-brand-500 dark:text-brand-400 mb-4">
            Online Courses
          </p>
          <h1 class="text-brand-700 dark:text-brand-100 mb-6">
            Learn at your own pace
          </h1>
          <p class="text-lg text-brand-600 dark:text-brand-400">
            Self-paced training programs designed for sales leaders and their teams. Master prospecting, pipeline management, and closing techniques on your schedule.
          </p>
        </div>
        <div class="flex justify-center">
          <img
            src="/jason-howes-sales-training-workshops.webp"
            alt="Jason Howes Sales Training"
            class="w-full rounded-2xl shadow-xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Course -->
  {courses.filter(c => c.featured).map((course) => (
    <section class="py-16 md:py-24 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-brand-100 dark:bg-brand-800 text-brand-600 dark:text-brand-300 text-xs font-medium mb-4">
              Most Popular
            </span>
            <h2 class="text-brand-700 dark:text-brand-100 mb-2">
              {course.title}
            </h2>
            <p class="text-lg text-brand-500 dark:text-brand-400 mb-4">
              {course.subtitle}
            </p>
            <p class="text-brand-600 dark:text-brand-400 mb-6">
              {course.description}
            </p>

            <div class="flex flex-wrap gap-6 mb-8 text-sm text-brand-600 dark:text-brand-400">
              <span class="flex items-center gap-2">
                <i class="bx bx-time text-lg"></i>
                {course.duration}
              </span>
              <span class="flex items-center gap-2">
                <i class="bx bx-laptop text-lg"></i>
                {course.format}
              </span>
            </div>

            <div class="flex items-center gap-6">
              <a href={course.link} class="btn btn-primary">
                Learn More
              </a>
              <a href="#" class="btn btn-link">
                Contact us
              </a>
            </div>
          </div>
          <div class="flex justify-center">
            <div class="w-full max-w-md aspect-video rounded-2xl bg-brand-200 dark:bg-brand-800 flex items-center justify-center">
              <i class="bx bx-play-circle text-6xl text-brand-400 dark:text-brand-600"></i>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- All Courses -->
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-brand-700 dark:text-brand-100 mb-12">
        All Courses
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {courses.filter(c => !c.featured).map((course) => (
          <div class="bg-brand-50 dark:bg-brand-900 rounded-2xl p-6 md:p-8 border border-brand-200 dark:border-brand-700 flex flex-col">
            <h3 class="text-xl text-brand-700 dark:text-brand-100 mb-2">
              {course.title}
            </h3>
            <p class="text-sm text-brand-500 dark:text-brand-400 mb-4">
              {course.subtitle}
            </p>
            <p class="text-sm text-brand-600 dark:text-brand-400 mb-6 flex-grow">
              {course.description}
            </p>

            <div class="flex flex-wrap gap-4 mb-6 text-xs text-brand-500 dark:text-brand-500">
              <span>{course.duration}</span>
              <span>{course.format}</span>
            </div>

            <div class="flex items-center justify-end">
              <a href={course.link} class="btn btn-link">
                Learn more
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-4">
        Not sure which course is right for you?
      </h2>
      <p class="mb-8">
        Book a free 15-minute consultation and we'll help you choose the program that fits your goals.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-primary">
          Book a Call
        </a>
        <a href="/contact" class="btn btn-secondary">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

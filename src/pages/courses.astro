---
// Courses page
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const courses = [
  {
    title: 'Consultative Selling: Land a $10m Contract',
    subtitle: 'Uncover buying motives through strategic questioning',
    description: 'Teaches uncovering buying motives through strategic questioning. Techniques used in securing 8-figure deals. Combinable with the Closing course.',
    duration: 'Full-day',
    format: 'Workshop',
    link: '#',
    featured: true
  },
  {
    title: 'Prospecting: Become a Confident Hunter',
    subtitle: 'Build a steady pipeline of qualified opportunities',
    description: 'Build a steady pipeline of qualified opportunities. Includes 5x 60-minute sessions (fortnightly), microlearning, and coaching review.',
    duration: 'Full-day',
    format: 'Workshop',
    link: '#'
  },
  {
    title: 'Closing: Win More, Win Smarter',
    subtitle: 'Identify decision points and remove roadblocks',
    description: 'Uses milestone-driven approach to identify decision points and remove roadblocks. Works alongside Consultative Selling with applied coaching.',
    duration: 'Full-day',
    format: 'Workshop',
    link: '#'
  },
  {
    title: 'Sales Mindset: Uncover Hidden Barriers',
    subtitle: 'Identify mindset blocks limiting performance',
    description: 'Identifies mindset blocks limiting performance. Includes 3x 60-minute virtual sessions (weekly), 1x 30-minute coaching, microlearning videos, and weekly tasks.',
    duration: 'Half-day',
    format: 'Virtual',
    link: '#'
  },
  {
    title: 'Relationship Building: Accelerate Trust',
    subtitle: 'Develop trusted advisor positioning',
    description: 'Develops trusted advisor positioning to shorten sales cycles. Virtual program format with practical exercises and microlearning.',
    duration: 'Half-day',
    format: 'Virtual',
    link: '#'
  },
  {
    title: 'Selling Value: Protect Your Margin',
    subtitle: 'Position as strategic choice not price-focused',
    description: 'Teaches positioning as a strategic choice rather than a price-focused competitor. Half-day format with tailored pricing exercises and role-plays.',
    duration: 'Half-day',
    format: 'Workshop',
    link: '#'
  }
];
const pageTitle = "Sales Training Courses | Jason Howes Online Programs";
const pageDescription = "Self-paced online sales courses covering prospecting, sales management, storytelling, and recruiting. Learn from Jason Howes with 35+ years of sales leadership experience.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Nav variant="light" />

  <!-- Hero -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm uppercase tracking-[0.15em] text-brand-500 dark:text-brand-400 mb-4">
            Online Courses
          </p>
          <h1 class="text-brand-700 dark:text-brand-100 mb-6">
            Learn at your own pace
          </h1>
          <p class="text-lg text-brand-600 dark:text-brand-400">
            Self-paced training programs designed for sales leaders and their teams. Master prospecting, pipeline management, and closing techniques on your schedule.
          </p>
        </div>
        <div class="flex justify-center">
          <img
            src="/jason-howes-sales-training-workshops.webp"
            alt="Jason Howes Sales Training"
            class="w-full rounded-2xl shadow-xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Course -->
  {courses.filter(c => c.featured).map((course) => (
    <section class="py-16 md:py-24 px-4 ">
      <div class="max-w-7xl mx-auto">
        <div class="card-glass-solid p-8 md:p-12 lg:p-16 border border-brand-200 dark:border-brand-700">
          <span class="inline-block px-3 py-1 rounded-full bg-brand-100 dark:bg-brand-700 text-brand-600 dark:text-brand-300 text-xs font-medium mb-6">
            High-Impact Courses
          </span>
          <h2 class="text-brand-700 dark:text-brand-100 mb-4">
            {course.title}
          </h2>
          <p class="text-lg text-brand-500 dark:text-brand-400 mb-6">
            {course.subtitle}
          </p>
          <p class="text-brand-600 dark:text-brand-400 mb-8 max-w-3xl">
            {course.description}
          </p>

          <div class="flex flex-wrap gap-6 mb-8 text-sm text-brand-600 dark:text-brand-400">
            <span class="flex items-center gap-2">
              <i class="bx bx-time text-lg"></i>
              {course.duration}
            </span>
            <span class="flex items-center gap-2">
              <i class="bx bx-laptop text-lg"></i>
              {course.format}
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <a href="/contact?from=courses-learn" class="btn btn-primary">
              Learn More
            </a>
            <a href="/contact?from=courses" class="btn btn-secondary">
              Contact us
            </a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- All Courses -->
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-brand-700 dark:text-brand-100 mb-12">
        All Courses
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {courses.filter(c => !c.featured).map((course) => (
          <div class="card-glass-solid flex flex-col h-full hover:shadow-lg transition-shadow">
            <!-- Format Badge Section -->
            <div class="px-6 md:px-8 pt-6 md:pt-8 pb-4">
              <div class="flex flex-wrap gap-3 mb-4">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-200 dark:bg-brand-700 text-brand-700 dark:text-brand-200 text-xs font-semibold uppercase tracking-wider">
                  <i class="bx bx-time text-sm"></i>
                  {course.duration}
                </span>
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-200 dark:bg-brand-700 text-brand-700 dark:text-brand-200 text-xs font-semibold uppercase tracking-wider">
                  <i class="bx bx-laptop text-sm"></i>
                  {course.format}
                </span>
              </div>
            </div>

            <!-- Content Section -->
            <div class="px-6 md:px-8 pb-6 md:pb-8 flex flex-col grow">
              <h3 class="text-lg font-bold text-brand-700 dark:text-brand-100 mb-2 leading-snug">
                {course.title}
              </h3>
              <p class="text-sm text-brand-600 dark:text-brand-300 mb-3 font-semibold">
                {course.subtitle}
              </p>
              <p class="text-sm text-brand-600 dark:text-brand-400 mb-6 grow leading-relaxed">
                {course.description}
              </p>

              <!-- CTA Button -->
              <a href="/contact?from=courses-learn" class="w-full bg-brand-600 hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-600 text-white dark:text-brand-900 font-semibold uppercase tracking-widest text-sm py-3 px-4 rounded-lg transition-colors text-center">
                Learn More
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="mb-4">
        Not sure which course is right for you?
      </h2>
      <p class="mb-8">
        Book a free 15-minute consultation and we'll help you choose the program that fits your goals.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact?from=courses-book" class="btn btn-primary">
          Book a Call
        </a>
        <a href="/contact?from=courses" class="btn btn-secondary">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

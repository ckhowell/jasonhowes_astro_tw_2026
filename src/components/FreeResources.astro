---
import Card from './Card.astro';
---

<section id="free-resources" class="px-4 py-12 md:py-6">
  <div class="mx-auto max-w-5xl p-8 md:p-12">
    <div class="mx-auto max-w-2xl text-center mb-8">
      <!-- <h5 class="pb-16 mt-2 mb-5 text-4xl font-semibold tracking-tight text-pretty text-white sm:text-5xl lg:text-balance">FREE RESOURCES</h5> -->
      <!-- <h3 class="text-sm md:text-base/9 text-brand-300">DOWNLOAD JASON'S FREE GUIDES TO ATTRACT MORE CLIENTS AND BOOST SALES</h3> -->
    </div>
    <div class="flex flex-col md:flex-row gap-6 md:gap-10 justify-center items-center">
      <Card
        image="/whitepaper_cover.png"
        heading="Compensation Guide"
        subheading="Pay & performance"
        copy="A proven model to optimise pay, motivate sales teams, and retain talent."
        buttonText="Download"
        modalResource="Compensation Guide"
      />
      <Card
        image="/onboarding.png"
        heading="Onboarding Process"
        subheading="Clarity from day one"
        copy="Hiring well isn't enough. Clear strategy and expectations help new hires perform faster."
        buttonText="Download"
        modalResource="Onboarding Process"
      />
    </div>
  </div>
</section>

<!-- Resource Download Modal -->
<div
  id="resource-modal"
  class="fixed inset-0 z-50 items-center justify-center p-4 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Backdrop -->
  <div
    id="modal-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
  ></div>

  <!-- Panel -->
  <div class="relative z-10 w-full max-w-md bg-white dark:bg-brand-900 rounded-2xl shadow-2xl p-8">
    <!-- Close button -->
    <button
      id="modal-close"
      type="button"
      class="absolute top-4 right-4 text-brand-400 hover:text-brand-700 dark:hover:text-brand-200 transition-colors"
      aria-label="Close"
    >
      <i class="bx bx-x text-2xl"></i>
    </button>

    <!-- Header -->
    <div class="mb-6">
      <h2 id="modal-title" class="text-2xl font-bold text-brand-700 dark:text-brand-100 mb-1 leading-tight">
        Get your free resource
      </h2>
      <p class="text-sm text-brand-500 dark:text-brand-400">
        We'll send <strong id="modal-resource-name" class="text-brand-600 dark:text-brand-300"></strong> to your inbox.
      </p>
    </div>

    <!-- Netlify Form -->
    <form
      name="resource-download"
      method="POST"
      action="/resources-success"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="space-y-4"
    >
      <input type="hidden" name="form-name" value="resource-download" />
      <input type="hidden" name="resource" id="form-resource-field" value="" />
      <!-- Honeypot -->
      <p class="hidden">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>

      <div>
        <label for="full-name" class="block text-sm font-medium text-brand-700 dark:text-brand-200 mb-1">
          Full Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="full-name"
          name="full-name"
          required
          class="w-full rounded-lg border border-brand-200 dark:border-brand-700 bg-white dark:bg-brand-800 px-4 py-2.5 text-brand-700 dark:text-brand-100 placeholder-brand-300 dark:placeholder-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-400"
          placeholder="Jane Smith"
        />
      </div>

      <div>
        <label for="company" class="block text-sm font-medium text-brand-700 dark:text-brand-200 mb-1">
          Company <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="company"
          name="company"
          required
          class="w-full rounded-lg border border-brand-200 dark:border-brand-700 bg-white dark:bg-brand-800 px-4 py-2.5 text-brand-700 dark:text-brand-100 placeholder-brand-300 dark:placeholder-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-400"
          placeholder="Acme Corp"
        />
      </div>

      <div>
        <label for="position" class="block text-sm font-medium text-brand-700 dark:text-brand-200 mb-1">
          Position <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="position"
          name="position"
          required
          class="w-full rounded-lg border border-brand-200 dark:border-brand-700 bg-white dark:bg-brand-800 px-4 py-2.5 text-brand-700 dark:text-brand-100 placeholder-brand-300 dark:placeholder-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-400"
          placeholder="Sales Manager"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-brand-700 dark:text-brand-200 mb-1">
          Email <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full rounded-lg border border-brand-200 dark:border-brand-700 bg-white dark:bg-brand-800 px-4 py-2.5 text-brand-700 dark:text-brand-100 placeholder-brand-300 dark:placeholder-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-400"
          placeholder="jane@example.com"
        />
      </div>

      <button
        type="submit"
        class="w-full inline-flex items-center justify-center gap-2 rounded-full bg-brand-600 px-8 py-3 font-semibold text-white shadow-lg transition-colors hover:bg-brand-700 focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2"
      >
        Send me the resource
        <i class="bx bx-send text-xl"></i>
      </button>
    </form>
  </div>
</div>

<script>
  function initModal() {
    const modal = document.getElementById('resource-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    const resourceNameEl = document.getElementById('modal-resource-name');
    const formResourceField = document.getElementById('form-resource-field') as HTMLInputElement | null;

    if (!modal || !backdrop || !closeBtn || !resourceNameEl || !formResourceField) return;

    function openModal(resourceName: string) {
      resourceNameEl!.textContent = resourceName;
      formResourceField!.value = resourceName;
      modal!.classList.remove('hidden');
      modal!.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal!.classList.add('hidden');
      modal!.classList.remove('flex');
      document.body.style.overflow = '';
    }

    // Open on card button click
    document.querySelectorAll('[data-open-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const resource = (btn as HTMLElement).dataset.openModal ?? '';
        openModal(resource);
      });
    });

    // Close on backdrop click or close button
    backdrop.addEventListener('click', closeModal);
    closeBtn.addEventListener('click', closeModal);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal!.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  // Run on initial load and after every View Transition navigation
  document.addEventListener('astro:page-load', initModal);
</script>

<script>
  // Track if global listeners have been added (these persist across View Transitions)
  let globalListenersAdded = false;

  // Update theme icon based on current state
  function updateThemeIcon() {
    const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

    if (document.documentElement.classList.contains('dark')) {
      themeToggleLightIcon?.classList.remove('hidden');
      themeToggleDarkIcon?.classList.add('hidden');
    } else {
      themeToggleDarkIcon?.classList.remove('hidden');
      themeToggleLightIcon?.classList.add('hidden');
    }
  }

  // Header scroll background handler
  function updateHeaderBackground() {
    const siteHeader = document.getElementById('site-header');
    if (!siteHeader) return;
    if (window.scrollY > 12) {
      siteHeader.classList.add('scrolled');
    } else {
      siteHeader.classList.remove('scrolled');
    }
  }

  // Initialize nav functionality
  function initNav() {
    // Always update icon state and header background (elements may be new after View Transition)
    updateThemeIcon();
    updateHeaderBackground();

    // Only set up global event listeners once (document/window persist across transitions)
    if (globalListenersAdded) return;
    globalListenersAdded = true;

    // Scroll listener on window (persists across View Transitions)
    window.addEventListener('scroll', updateHeaderBackground, { passive: true });

    // Use event delegation for theme toggle (document persists across View Transitions)
    // This way we don't need to reattach handlers to new button elements
    document.addEventListener('click', function(e) {
      const toggleBtn = e.target.closest('#theme-toggle');
      if (toggleBtn) {
        // Toggle dark class on html element
        document.documentElement.classList.toggle('dark');
        localStorage.setItem('color-theme',
          document.documentElement.classList.contains('dark') ? 'dark' : 'light'
        );
        updateThemeIcon();
      }
    });
  }

  // Run on initial page load
  initNav();

  // Re-run after View Transitions complete (to update icon state)
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 200ms ease, border-color 200ms ease, backdrop-filter 200ms ease;
  }

  .site-header.scrolled {
    background-color: rgba(222, 231, 244, 0.92);
    border-bottom-color: rgba(90, 148, 209, 0.25);
    backdrop-filter: blur(16px);
  }

  html.dark .site-header.scrolled {
    background-color: rgba(10, 21, 32, 0.92);
    border-bottom-color: rgba(36, 74, 120, 0.45);
  }
</style>

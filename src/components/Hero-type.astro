              <!-- <span
            class="text-xs uppercase tracking-[0.15em] font-semibold text-brand-600 dark:text-brand-400"
          >
            Featured Book
          </span> -->
            </div>
            <p
              class="text-xs uppercase tracking-[0.15em] font-semibold text-brand-600 dark:text-brand-400 mb-3"
            >
              The Predictive Guide to Hiring Top Sales Professionals
            </p>

            <p
              class="text-xl sm:text-2xl lg:text-3xl text-brand-700! dark:text-brand-400! mb-6 lg:leading-9"
            >
              Crystal Ball Recruiting uses 91% accurate, science-backed
              assessments to identify the top 20% of sales professionals—before
              you invest $200K.
            </p>
            <div
              class="flex items-center gap-2 text-sm text-brand-700! dark:text-brand-400!"
            >
              <svg
                class="w-4 h-4 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
              >
              <span>Based on 2M+ assessments with proven results</span>
            </div>
          </div>
        </div>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/sales-dna-assessment"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-600 px-8 py-4 font-semibold text-white shadow-lg transition-colors hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400"
          >
            Get a Sales DNA Assessment
            <i class="bx bx-right-arrow-alt text-xl"></i>
          </a>
          <a
            href="/books"
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-brand-600 px-8 py-4 font-semibold text-brand-700 transition-colors hover:bg-brand-100 dark:border-brand-400 dark:text-brand-300 dark:hover:bg-brand-900"
          >
            <i class="bx bx-book-open text-xl"></i>
            Read the Book
          </a>
        </div>
      </div>
      <div class="hidden lg:block"></div>
    </div>
  </div>
</section>

<style is:global>
  /* Duotone color overlay - sits behind the image */
  .hero-duotone-overlay {
    position: absolute;
    inset: 0;
    /* Light mode: brand-400 blue tint */
    background: linear-gradient(135deg, #5a94d1 0%, #3a78bc 100%);
    pointer-events: none;
  }

  html.dark .hero-duotone-overlay {
    /* Dark mode: brand-800 to brand-900 deep blue */
    background: linear-gradient(135deg, #1a3557 0%, #0e1c2b 100%);
  }

  /* Image overlay with blend mode for duotone effect */
  .hero-water-overlay {
    position: absolute;
    inset: 0;
    background-image: url("/jason-howes-sales-recruitment-hero-2.webp");
    background-size: cover;
    background-position: center;
    opacity: 0.7;
    filter: grayscale(100%) contrast(1.1);
    mix-blend-mode: luminosity;
    pointer-events: none;
  }

  html.dark .hero-water-overlay {
    opacity: 0.6;
    filter: grayscale(100%) contrast(1.2) brightness(0.8);
  }

  /* Gradient overlay for text readability */
  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    /* Mobile: vertical gradient covering full height */
    background: linear-gradient(
      180deg,
      rgba(222, 231, 244, 0.97) 0%,
      rgba(222, 231, 244, 0.92) 60%,
      rgba(222, 231, 244, 0.75) 100%
    );
    pointer-events: none;
  }

  /* Tablet and up: switch to horizontal gradient */
  @media (min-width: 768px) {
    .hero-gradient-overlay {
      background: linear-gradient(
        90deg,
        rgba(222, 231, 244, 0.95) 0%,
        rgba(222, 231, 244, 0.75) 35%,
        rgba(222, 231, 244, 0.3) 60%,
        rgba(222, 231, 244, 0) 100%
      );
    }
  }

  html.dark .hero-gradient-overlay {
    background: linear-gradient(
      180deg,
      rgba(10, 21, 32, 0.97) 0%,
      rgba(10, 21, 32, 0.92) 60%,
      rgba(10, 21, 32, 0.8) 100%
    );
  }

  @media (min-width: 768px) {
    html.dark .hero-gradient-overlay {
      background: linear-gradient(
        90deg,
        rgba(10, 21, 32, 0.95) 0%,
        rgba(10, 21, 32, 0.85) 40%,
        rgba(10, 21, 32, 0.5) 70%,
        rgba(10, 21, 32, 0) 100%
      );
    }
  }
</style>

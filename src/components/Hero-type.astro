<section
  class="relative flex items-center justify-center min-h-screen bg-checkered"
>
  <div class="hero-duotone-overlay" aria-hidden="true"></div>
  <div class="hero-water-overlay" aria-hidden="true"></div>
  <div class="hero-gradient-overlay" aria-hidden="true"></div>
  <div
    class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-8 sm:pt-28 sm:pb-12 md:py-16"
  >
    <div class="grid lg:grid-cols-3 gap-8 items-center">
      <div class="lg:col-span-2 text-center md:text-left">
        <!-- Title -->
        <h1
          class="mb-4 py-4 md:py-6 md:mb-6 leading-tight text-1xl sm:text-5xl md:text-6xl lg:text-[6rem] xl:text-[7rem] text-brand-700! dark:text-brand-400!"
        >
          50% of sales hires fail. Yours don't have to.
        </h1>
        <!-- Book feature area -->

        <!-- Two column layout -->
        <div class="flex flex-col sm:flex-row gap-6 mb-6">
          <!-- Col 1: Book image -->
          <div class="shrink-0 mx-auto sm:mx-0">
            <img
              src="/front.webp"
              alt="Crystal Ball Recruiting Book Cover"
              class="w-36 sm:w-40 md:w-40 h-auto object-contain -rotate-1 drop-shadow-[0_20px_20px_rgba(0,0,0,0.5)]"
            />
          </div>

          <!-- Col 2: Description -->
          <div class="flex flex-col justify-start">
            <!-- Featured label with stars -->
            <div
              class="flex flex-col items-center md:flex-row md:items-center gap-1 md:gap-2 mb-2"
            >
              <span class="flex gap-0.5">
                <svg
                  class="w-3.5 h-3.5 text-yellow-400 fill-current"
                  viewBox="0 0 20 20"
                  ><path
